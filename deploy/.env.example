# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 含口令，不要提交到代码仓库

# ---------- MySQL 8.0 ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=change-me-app
# 宿主机映射端口；若本机 3306 空闲可改为 3306
MYSQL_HOST_PORT=3307

# ---------- Redis 7 ----------
REDIS_PASSWORD=change-me-redis
# 宿主机映射端口；若本机 6379 空闲可改为 6379
REDIS_HOST_PORT=6380

# ---------- MinIO ----------
MINIO_ROOT_USER=yszxadmin
MINIO_ROOT_PASSWORD=change-me-minio
# 宿主机映射端口；若本机 9000/9001 空闲可改回 9000/9001
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
MINIO_BUCKET=yszx
